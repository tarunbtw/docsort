# APMix AI Configuration
# Paste your APMix API key here:
APMIX_API_KEY=your_apmix_api_key_here

# Base URLs (read at call time; change without restarting is NOT supported — restart the engine)
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_ANTHROPIC_BASE_URL=https://api.apmix.ai

# Default Model (e.g. claude-3-5-sonnet-20241022, gpt-4o, claude-3-haiku-20240307)
APMIX_MODEL=claude-3-5-sonnet-20241022

# Mode: leave empty for standard OpenAI-compatible /chat/completions, or set to 'anthropic' for /v1/messages
APMIX_MODE=

# Stage 2 strictness.
# false (default): if the LLM call fails or no key is configured, a relevant
#   document is still returned as status=processed with empty metadata and
#   extraction_status=llm_unavailable, so the app stays usable without quota.
# true: a Stage 2 failure is returned as status=error (fail loudly).
LLM_REQUIRED=false
