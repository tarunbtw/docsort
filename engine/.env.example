# ---------------------------------------------------------------------------
# LLM providers (used by Stage 2 structured extraction)
# ---------------------------------------------------------------------------
# LLM_PROVIDERS is a JSON array. ORDER IS FAILOVER ORDER: the first provider that
# answers is used; on a missing key, HTTP error, timeout or unparseable response
# the next provider is tried, then the list is cycled again (LLM_MAX_PASSES).
#
# Both "openai" (POST /chat/completions) and "anthropic" (POST /v1/messages)
# wire protocols are supported. Most hosted providers expose an OpenAI-compatible
# endpoint, including Groq, Gemini, OpenRouter and Together.
#
# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# LLM Providers failover array
LLM_PROVIDERS=[{"name":"groq","mode":"openai","base_url":"https://api.groq.com/openai/v1","model":"openai/gpt-oss-120b","api_key_env":"GROQ_API_KEY"}]

# If LLM_PROVIDERS is empty, a single provider is built from the legacy APMIX_*
# variables below, so existing configurations keep working unchanged.
APMIX_API_KEY=your_apmix_api_key_here
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_ANTHROPIC_BASE_URL=https://api.apmix.ai
APMIX_MODEL=deepseek-v4-flash-free
APMIX_MODE=

# How many times the full provider list may be cycled before giving up.
LLM_MAX_PASSES=2

# ---------------------------------------------------------------------------
# Extraction shape
# ---------------------------------------------------------------------------
# Characters of leading context used for the header pass.
LLM_LEAD_CHARS=10000
# Chunks sampled from the remainder for the supersession coverage pass.
LLM_COVERAGE_CHUNKS=8

# ---------------------------------------------------------------------------
# Stage 2 strictness
# ---------------------------------------------------------------------------
# false (default): if every provider fails, a relevant document is still returned
#   as status=processed with empty metadata and extraction_status=llm_unavailable,
#   so the app stays usable.
# true: a Stage 2 failure is returned as status=error (fail loudly).
LLM_REQUIRED=false

# ---------------------------------------------------------------------------
# Stage 1 relevance thresholds (chunk-aggregated)
# ---------------------------------------------------------------------------
# Relevant when any chunk is this confident, or this share of chunks exceed 0.5.
RELEVANT_PMAX_THRESHOLD=0.8
RELEVANT_FRAC_THRESHOLD=0.3
# Not relevant when the strongest chunk is below this and the share is below.
NEGATIVE_PMAX_THRESHOLD=0.4
NEGATIVE_FRAC_THRESHOLD=0.1
