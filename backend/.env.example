# Server Port
PORT=8080

# Supabase Database URL (From Supabase Project Settings -> Database -> Connection string -> URI)
# Leave empty to automatically use persistent local SQLite at ./storage/docsort.db
DATABASE_URL=

# Supabase Storage & API (From Supabase Project Settings -> API)
# Leave empty to automatically use local disk storage at ./storage/uploads/
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=documents

# Python ML Engine URL
PYTHON_ENGINE_URL=http://127.0.0.1:8000
